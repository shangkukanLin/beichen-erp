# 北辰 ERP 生产环境变量样例（P0 配置外置）
#
# 用法：
#   cp deploy/prod.env.sample /etc/beichen/erp.env && vi /etc/beichen/erp.env
#   chmod 600 /etc/beichen/erp.env          # 含口令，务必收紧权限
#   由 systemd 的 EnvironmentFile 注入（见 deploy/beichen-erp.service.sample）
#
# 说明：
#   - 带 [必填] 的项在 prod profile 下**没有默认值** → 不填则启动失败（这是有意设计，避免误用开发默认值）
#   - 不带标记的项使用 application.yml 中的默认值，可按需覆盖

# ---------- 数据库 ----------
[必填] DB_URL          = jdbc:mysql://127.0.0.1:3306/beichen_erp?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false
[必填] DB_USERNAME     = beichen_app
[必填] DB_PASSWORD     = <强口令>
# 首次部署（空库）保持 always 让 schema.sql 建表；结构变更受控发布时可改 never
       SQL_INIT_MODE   = always

# ---------- 跨域 ----------
# [必填] 逗号分隔的**前端访问地址**白名单（含协议与端口），例如：
[必填] CORS_ALLOWED_ORIGINS = https://erp.example.com

# ---------- 初始口令 ----------
# [必填] 仅用于"首次创建"平台超管 lin 与新公司管理员；登录后应立即改密
[必填] INIT_ADMIN_PASSWORD  = <初始强口令>

# ---------- 日志（P0：必须落盘，否则审计与告警不可追溯） ----------
       LOG_FILE        = /var/log/beichen/beichen-erp.log
       LOG_LEVEL       = info

# ---------- 上传 ----------
# 绝对路径，并纳入备份；同一目录需对运行用户可写
       UPLOAD_PATH     = /data/beichen/uploads
       UPLOAD_MAX_FILE_SIZE = 200MB

# ---------- 服务与会话 ----------
       SERVER_PORT     = 8080
       SA_TOKEN_TIMEOUT = 86400

# ---------- 定时任务（多实例：只在一个实例置 true） ----------
# 任务内部另有 MySQL 命名锁兜底，重复执行会被自动跳过
       SCHEDULING_ENABLED = false

# ---------- 会话共享（可选，需先在 pom 引入 sa-token-redis-jackson + spring-boot-starter-data-redis） ----------
# 未接入 Redis 前必须单实例部署；接入后填写：
#      SPRING_DATA_REDIS_HOST = 127.0.0.1
#      SPRING_DATA_REDIS_PORT = 6379
#      SPRING_DATA_REDIS_PASSWORD = <口令>
